# Generated by Cargo
# will have compiled files and executables
/target/
# Optional scratch target dir. Not needed in normal use: the E0786/rlib
# build failures this was introduced for came from concurrent recursive
# disk scans reading target/ mid-build, not from sharing it with clippy.
/target-clippy/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Staged by build.rs: transcribe-cpp shared runtime libraries (Windows DLLs /
# Linux .so), bundled next to the executable — to the install root via
# tauri.windows.conf.json on Windows, into /usr/lib/Handy (deb/rpm) via
# tauri.conf.json on Linux.
/transcribe-libs/
